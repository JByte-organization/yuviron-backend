{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  
  "CorsSettings": {
    "AllowedOrigins": [
      "https://yuviron.com",
      "https://backoffice.yuviron.com",
      "https://admin.yuviron.com",
      "https://dev.yuviron.com",
      "https://dev-backoffice.yuviron.com",
      "https://dev-admin.yuviron.com"
    ]
  },

  "ConnectionStrings": {
    "Default": "REPLACE_IN_PROD",
    "Redis": "REPLACE_IN_PROD"
  },
  "FILE_STORAGE_ROOT": "/var/yuviron/storage",

  "JwtSettings": {
    "Secret": "PLEASE_REPLACE_THIS_SUPER_SECRET_KEY_IN_PRODUCTION",
    "Issuer": "YuvironApi",
    "Audience": "YuvironClient",
    "ExpiryMinutes": 10
  },

  "Email": {
    "Host": "smtp.gmail.com",
    "Port": "587",
    "Username": "dummy@gmail.com",
    "Password": "DUMMY_PASSWORD"
  },

  "SeedUsers": {
    "Admin": { "Email": "admin@example.com", "Password": "DUMMY" },
    "Manager": { "Email": "manager@example.com", "Password": "DUMMY" },
    "User": { "Email": "user@example.com", "Password": "DUMMY" },
    "Premium": { "Email": "premium@example.com", "Password": "DUMMY" }
  }
}